# GEMINI_API_KEY: Required for Gemini AI safety analysis and emergency assistant.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Telegram Bot Integration (Server-side alerts)
TELEGRAM_BOT_TOKEN="MY_TELEGRAM_BOT_TOKEN"
TELEGRAM_DEFAULT_CHAT_ID="MY_TELEGRAM_CHAT_ID"

# Firebase Client Configuration (Optional for Cloud persistence, app features built-in fallback)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

